{
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt", "inkTone", "glossEnabled"],
  "properties": {
    "prompt": {"type": "string", "minLength": 1, "title": "提示词"},
    "inkTone": {"type": "string", "enum": ["clay", "ash", "sage"], "title": "墨色"},
    "glossEnabled": {"type": "boolean", "title": "启用光泽"},
    "grainLevel": {"type": "number", "minimum": 0, "maximum": 1, "title": "颗粒强度"},
    "layout/options": {
      "type": "object",
      "title": "布局选项",
      "additionalProperties": false,
      "required": ["mix~ratio"],
      "properties": {
        "mix~ratio": {"type": "number", "minimum": 0, "maximum": 1, "title": "混合比例"}
      }
    },
    "passes": {
      "type": "array",
      "title": "处理顺序",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "gain/value"],
        "properties": {
          "mode": {"type": "string", "enum": ["base", "overlay"], "title": "处理模式"},
          "gain/value": {"type": "number", "minimum": 0, "maximum": 1, "title": "增益"}
        }
      }
    }
  }
}
