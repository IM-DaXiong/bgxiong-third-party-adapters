{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/media-target-selection-v1/analyze.input.schema.json",
  "type": "object",
  "properties": {
    "source": {
      "$ref": "read-only-source-identity.schema.json"
    },
    "detectionParams": {
      "type": "object",
      "properties": {
        "detector": { "type": "string", "minLength": 1, "default": "bbox/face_yolov8m.pt" },
        "confidence": { "type": "number", "minimum": 0.05, "maximum": 0.95, "default": 0.35 },
        "cutDetection": { "type": "string", "enum": ["none", "auto"], "default": "auto" },
        "cutThreshold": { "type": "number", "minimum": 0.5, "maximum": 20, "default": 3 },
        "selectHint": {
          "type": "string",
          "enum": ["largest_face", "smallest_face", "left_most", "right_most", "top_most", "bottom_most", "centre_most", "closest_to_xy", "detector_score"],
          "default": "largest_face"
        },
        "force": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "pageCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "source"
  ],
  "additionalProperties": false
}
