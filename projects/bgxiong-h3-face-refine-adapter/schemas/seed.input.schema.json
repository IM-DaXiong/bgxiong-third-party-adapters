{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed.input.schema.json",
  "type": "object",
  "properties": {
    "sampleMediaIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 5,
      "readOnly": true
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "minLength": 1
          },
          "imageDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "mediaId",
          "imageDigest",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 5,
      "readOnly": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.95
    }
  },
  "required": [
    "sampleMediaIds",
    "samples"
  ],
  "additionalProperties": false
}
