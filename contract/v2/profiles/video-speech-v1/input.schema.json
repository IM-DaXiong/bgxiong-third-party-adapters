{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/vendor-adapter/v2/profiles/video-speech-v1/input.schema.json",
  "title": "VideoSpeechV1Input",
  "description": "SOURCE DRAFT: one portrait and one prepared driving-audio segment. Package parameters must be specialized to a closed schema before registration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "portrait", "drivingAudio", "audio", "instruction", "parameters"],
  "properties": {
    "schemaVersion": {"const": 1},
    "portrait": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/mediaRef"}},
    "drivingAudio": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/mediaRef"}},
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "sampleRateHz", "channels", "sha256"],
      "properties": {
        "durationMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sampleRateHz": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "channels": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "instruction": {"type": "string"},
    "parameters": {
      "type": "object", "properties": {}, "required": [], "additionalProperties": false,
      "description": "Baseline declares no model-specific fields. Each package declares its supported fields here; never use an open bag or silently drop unknown fields."
    }
  },
  "$defs": {
    "mediaRef": {
      "type": "object", "additionalProperties": false, "required": ["mediaId"],
      "properties": {"mediaId": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}}
    }
  }
}
