{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "title": "ComfyUI selector dimension provenance; platform adapter only",
  "definitions": {
    "pathStep": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "outputIndex", "inputName", "transform"],
      "properties": {
        "nodeId": {"type": "string", "minLength": 1},
        "outputIndex": {"type": "integer", "minimum": 0},
        "inputName": {"type": "string"},
        "transform": {"type": "string", "enum": ["source", "identity", "half"]}
      }
    },
    "selectorProof": {
      "type": "object", "additionalProperties": false,
      "required": ["terminalNodeId", "selectorNodeId", "widthPath", "heightPath", "definitionDigest", "sourceGraphDigest"],
      "properties": {
        "terminalNodeId": {"type": "string", "minLength": 1},
        "selectorNodeId": {"type": "string", "minLength": 1},
        "widthPath": {"type": "array", "items": {"$ref": "#/definitions/pathStep"}, "minItems": 1},
        "heightPath": {"type": "array", "items": {"$ref": "#/definitions/pathStep"}, "minItems": 1},
        "definitionDigest": {"type": "string", "minLength": 1},
        "sourceGraphDigest": {"type": "string", "minLength": 1}
      }
    }
  }
}
