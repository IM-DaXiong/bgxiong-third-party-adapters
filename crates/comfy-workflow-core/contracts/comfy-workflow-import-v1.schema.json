{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfy-workflow-import-v1.schema.json",
  "schemaVersion": 1,
  "title": "ComfyWorkflowImportV1",
  "description": "PLAN 20261014 CW09/CW10/CW14/CW54. Private ComfyUI full-import contract: import session (root), item status, four-dimension readiness, structured diagnostics, paging/cancel, compile IR/provenance DTOs and the compile-only frontend bridge wire. Rust mirror: src-tauri/src/comfyui/workflow/import_types.rs and bgx-comfy-workflow types.rs/canvas. All objects are closed (additionalProperties=false); Option<T> is encoded as a required nullable field; internally tagged unions use `kind`. Budgets below are the single source (generated by bgx-comfy-workflow/build.rs). A cancelled item can never be ready.",
  "maxDefinitionCacheBytes": 100663296,
  "maxBridgeReplyBytes": 67108864,
  "importPageSize": 100,
  "maxSubgraphDepth": 32,
  "type": "object",
  "additionalProperties": false,
  "required": ["importSessionId", "items", "nextCursor", "publishedRevision"],
  "properties": {
    "importSessionId": { "type": "string", "minLength": 1 },
    "items": { "type": "array", "items": { "$ref": "#/$defs/importItem" } },
    "nextCursor": { "type": ["string", "null"], "minLength": 1 },
    "publishedRevision": { "type": ["integer", "null"], "minimum": 0 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]+$", "description": "sha256:<lowercase hex> over the exact bytes (source) or canonical sorted-key JSON (definitions)." },
    "diagnosticCode": { "type": "string", "description": "Closed import/compile diagnostic code set (error-code registry; consts in canvas::ir::codes, node_registry::definition::codes, compile_context::codes, frontend_bridge::codes, error_codes::workflow::IMPORT_*).", "enum": ["comfyCanvas.annotationAsSource", "comfyCanvas.apiLinkTargetMissing", "comfyCanvas.apiWidgetsSidecarNotExecuted", "comfyCanvas.boundaryInputUnconnected", "comfyCanvas.boundaryOutputUnconnected", "comfyCanvas.boundaryPortAmbiguous", "comfyCanvas.boundaryPortMismatch", "comfyCanvas.boundaryPortMissing", "comfyCanvas.bridgeEvidenceMismatch", "comfyCanvas.bridgeEvidenceMissing", "comfyCanvas.bridgeLinkMismatch", "comfyCanvas.bridgeNodeMissing", "comfyCanvas.bypassAmbiguous", "comfyCanvas.capabilityMismatch", "comfyCanvas.capabilityMissing", "comfyCanvas.capabilityPlanMissing", "comfyCanvas.definitionMissing", "comfyCanvas.definitionsIncomplete", "comfyCanvas.digestFailed", "comfyCanvas.executionCycle", "comfyCanvas.formatAmbiguous", "comfyCanvas.formatUnrecognized", "comfyCanvas.formatVersionUnsupported", "comfyCanvas.graphEmpty", "comfyCanvas.inputDoubleSource", "comfyCanvas.jsonEmpty", "comfyCanvas.jsonParseFailed", "comfyCanvas.legacyGroupNodeUnsupported", "comfyCanvas.linkIdCollision", "comfyCanvas.linkInconsistent", "comfyCanvas.linkInvalid", "comfyCanvas.linkMissing", "comfyCanvas.linkOriginMissing", "comfyCanvas.linkResolutionCycle", "comfyCanvas.linkSlotOutOfRange", "comfyCanvas.linkSourceDropped", "comfyCanvas.linkToInactive", "comfyCanvas.linkTypeMismatch", "comfyCanvas.missingClassType", "comfyCanvas.nodeIdCollision", "comfyCanvas.nodeIdInvalid", "comfyCanvas.nodeInvalid", "comfyCanvas.nodeModeInvalid", "comfyCanvas.outputInactive", "comfyCanvas.outputNotFound", "comfyCanvas.outputNotOutputNode", "comfyCanvas.outputSelectionEmpty", "comfyCanvas.outsideSelectedClosure", "comfyCanvas.overrideTargetUnused", "comfyCanvas.primitiveValueMissing", "comfyCanvas.promotedWidgetCountMismatch", "comfyCanvas.serializerProfileUnavailable", "comfyCanvas.sourceDigestMismatch", "comfyCanvas.specialRuleNotFound", "comfyCanvas.subgraphDefinitionCycle", "comfyCanvas.subgraphDefinitionDuplicate", "comfyCanvas.subgraphDefinitionInvalid", "comfyCanvas.subgraphDepthExceeded", "comfyCanvas.topLevelNotObject", "comfyCanvas.valueOriginUnknown", "comfyCanvas.widgetDoubleAccounted", "comfyCanvas.widgetIndexOutOfRange", "comfyCanvas.widgetUnaccounted", "workflowBridgeApiInvalid", "workflowBridgeDefinitionMismatch", "workflowBridgeEvidenceNodeUncovered", "workflowBridgeEvidenceReplaced", "workflowBridgeForeignSession", "workflowBridgeFrontendVersionMismatch", "workflowBridgeFrontendVersionUnknown", "workflowBridgeNotReady", "workflowBridgePluginDigestInvalid", "workflowBridgeReplyInvalid", "workflowBridgeReplyTooLarge", "workflowBridgeSourceDigestMismatch", "workflowBridgeSourceMapMismatch", "workflowBridgeTokenExpired", "workflowBridgeTransport", "workflowDefinitionInputOrderMissing", "workflowDefinitionMalformed", "workflowDefinitionMissing", "workflowDefinitionsIncomplete", "workflowDefinitionsUnavailable", "workflowDynamicComboOptionUnknown", "workflowEndpointUnbound", "workflowJsonParseFailed", "workflowLiteralInvalid", "workflowNeedsCompileContext", "workflowNeedsDefinitions", "workflowNeedsSerializationEvidence", "workflowPromotedOverrideInvalid", "workflowSerializerEvidenceRequired", "workflowSerializerProfileDrift", "workflowSpecialRuleMismatch", "workflowWidgetCountMismatch", "workflowWidgetValueInvalid", "workflowWidgetValueUnconsumed", "workflowImportSourceStale", "workflowImportRevisionConflict", "workflowImportRepositoryCorrupt", "workflowImportSourceKindInvalid", "workflowImportNotDerived", "workflowImportStageFailed", "workflowImportSessionNotFound", "workflowImportSessionIndexStale", "workflowImportSessionBusy", "workflowImportSessionCancelled", "workflowImportRequestInvalid", "workflowImportCursorInvalid", "workflowImportEndpointMismatch", "workflowImportDefinitionsUnavailable", "workflowMappingAmbiguous", "workflowSpecialRulePackageMismatch", "workflowSpecialRuleVersionUnknown", "workflowSpecialRuleVersionMismatch", "workflowSpecialRuleDefinitionDigestMismatch", "workflowDefaultsRequireReview"] },
    "importStage": { "type": "string", "enum": ["source", "parse", "detectFormat", "definitions", "capabilities", "bridgeStatus", "bridgeSession", "bridgeCompile", "compile", "mapping", "caps", "documentation", "publish"] },
    "nextAction": { "type": "string", "enum": ["confirmMapping", "fixSource", "openFrontendSession", "refreshDefinitions", "reimport", "resume", "prepareRuntime"] },
    "endpointIdentity": {
      "type": "object", "additionalProperties": false, "required": ["instanceId", "userScope"],
      "properties": { "instanceId": { "type": "string", "minLength": 1 }, "userScope": { "type": "string", "minLength": 1 } }
    },
    "sourceKind": { "type": "string", "enum": ["localFile", "localFolder", "remoteUserdata", "libraryReanalyze"] },
    "sourceIdentity": {
      "type": "object", "additionalProperties": false, "required": ["endpoint", "sourceKind", "path"],
      "properties": {
        "endpoint": { "oneOf": [{ "$ref": "#/$defs/endpointIdentity" }, { "type": "null" }] },
        "sourceKind": { "$ref": "#/$defs/sourceKind" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "importStatus": { "type": "string", "enum": ["sourceSaved", "needsDefinitions", "needsFrontendSession", "compiling", "needsMapping", "ready", "failed", "cancelled", "skipped"] },
    "readinessState": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "unknown" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "ready" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "items"], "properties": { "kind": { "const": "missing" }, "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } }
      ]
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceSaved", "conversionVerified", "mappingReady", "runtimeReady"],
      "properties": {
        "sourceSaved": { "type": "boolean" },
        "conversionVerified": { "type": "boolean" },
        "mappingReady": { "type": "boolean" },
        "runtimeReady": { "$ref": "#/$defs/readinessState" }
      }
    },
    "documentationStatus": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["disabled", "unavailable", "queued", "running", "complete", "cancelled"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "code"], "properties": { "kind": { "const": "failed" }, "code": { "type": "string", "minLength": 1 } } }
      ]
    },
    "nodeLocator": {
      "type": "object", "additionalProperties": false, "required": ["scopePath", "nodeId"],
      "properties": { "scopePath": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "nodeId": { "type": "string", "minLength": 1 } }
    },
    "diagnosticSeverity": { "type": "string", "enum": ["blocking", "nonBlocking"] },
    "compileDiagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["diagnosticId", "code", "severity", "locator", "classType", "inputName", "params"],
      "properties": {
        "diagnosticId": { "type": "string", "minLength": 1 },
        "code": { "$ref": "#/$defs/diagnosticCode" },
        "severity": { "$ref": "#/$defs/diagnosticSeverity" },
        "locator": { "oneOf": [{ "$ref": "#/$defs/nodeLocator" }, { "type": "null" }] },
        "classType": { "type": ["string", "null"] },
        "inputName": { "type": ["string", "null"] },
        "params": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "importRequest": {
      "type": "object", "additionalProperties": false, "required": ["sources", "smartDocumentation", "textModel", "cursor"],
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceIdentity" } },
        "smartDocumentation": { "type": "boolean" },
        "textModel": { "type": ["string", "null"], "minLength": 1 },
        "cursor": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "importItem": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "entryId", "sourceRevision", "sourceDigest", "status", "readiness", "documentation", "diagnostics", "nextAction"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceIdentity" },
        "entryId": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "integer", "minimum": 1 },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "status": { "$ref": "#/$defs/importStatus" },
        "readiness": { "$ref": "#/$defs/readiness" },
        "documentation": { "$ref": "#/$defs/documentationStatus" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/compileDiagnostic" } },
        "nextAction": { "oneOf": [{ "$ref": "#/$defs/nextAction" }, { "type": "null" }] },
        "duplicateOf": { "type": "string", "minLength": 1, "description": "Optional. Entry id whose latest source has the same sha256 (set only with status=skipped; the source was not saved)." }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "cancelled" } } }, "then": { "properties": { "readiness": { "properties": { "conversionVerified": { "const": false }, "mappingReady": { "const": false } } } } } }
      ]
    },
    "importGetRequest": {
      "type": "object", "additionalProperties": false, "required": ["importSessionId", "cursor"],
      "properties": { "importSessionId": { "type": "string", "minLength": 1 }, "cursor": { "type": ["string", "null"], "minLength": 1 } }
    },
    "importCancelRequest": {
      "type": "object", "additionalProperties": false, "required": ["importSessionId"],
      "properties": { "importSessionId": { "type": "string", "minLength": 1 } }
    },
    "importStageError": {
      "type": "object", "additionalProperties": false, "required": ["stage", "diagnostics"],
      "properties": { "stage": { "$ref": "#/$defs/importStage" }, "diagnostics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/compileDiagnostic" } } }
    },
    "casConflict": {
      "type": "object", "additionalProperties": false, "required": ["expected", "actual"],
      "properties": { "expected": { "type": "integer", "minimum": 0 }, "actual": { "type": "integer", "minimum": 0 } }
    },
    "stagedArtifacts": {
      "type": "object", "additionalProperties": false, "required": ["api", "caps", "mapping", "documentation"],
      "properties": { "api": {}, "caps": {}, "mapping": {}, "documentation": {} }
    },
    "mappingTarget": { "type": "string", "enum": ["positivePrompt", "negativePrompt", "seed", "steps", "cfg", "denoise", "width", "height", "aspectRatio", "resolution", "durationSeconds", "fps", "firstFrame", "lastFrame", "referenceImage", "referenceVideo", "referenceAudio", "mask", "outputImage", "outputVideo", "outputAudio", "advanced"] },
    "evidenceKind": { "type": "string", "enum": ["outputAncestry", "consumerPortType", "reviewedSemanticRule", "nameHint", "noteHint"] },
    "paramValueType": { "type": "string", "enum": ["int", "float", "boolean", "string", "combo"] },
    "advancedParamDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["bindingId", "label", "valueType", "value", "min", "max", "step", "options", "unit", "source", "inputName"],
      "properties": {
        "bindingId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "valueType": { "$ref": "#/$defs/paramValueType" },
        "value": {},
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "step": { "type": ["number", "null"] },
        "options": { "type": ["array", "null"] },
        "unit": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/nodeLocator" },
        "inputName": { "type": "string", "minLength": 1 }
      }
    },
    "nodeKey": {
      "type": "object", "additionalProperties": false, "required": ["scope", "localId"],
      "properties": { "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "localId": { "type": "string", "minLength": 1 } }
    },
    "linkRef": {
      "type": "object", "additionalProperties": false, "required": ["from", "outputSlot", "outputName", "outputType"],
      "properties": {
        "from": { "$ref": "#/$defs/nodeKey" },
        "outputSlot": { "type": "integer", "minimum": 0 },
        "outputName": { "type": ["string", "null"] },
        "outputType": { "type": ["string", "null"] }
      }
    },
    "outputGroup": {
      "type": "object", "additionalProperties": false, "required": ["groupId", "outputs", "media"],
      "properties": {
        "groupId": { "type": "string", "minLength": 1 },
        "outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "media": { "type": "array", "items": { "$ref": "#/$defs/mappingTarget" } }
      }
    },
    "variantProposal": {
      "type": "object", "additionalProperties": false, "required": ["variantId", "name", "removedLinks", "addedLinks", "affectedOutputs"],
      "description": "Named mode variant (CW54): explicit link diff and affected outputs. Never applied without a user choice; becomes a separate frozen graph version.",
      "properties": {
        "variantId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "removedLinks": { "type": "array", "items": { "$ref": "#/$defs/linkRef" } },
        "addedLinks": { "type": "array", "items": { "$ref": "#/$defs/linkRef" } },
        "affectedOutputs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "valueOrigin": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "index"], "properties": { "kind": { "const": "sourceWidget" }, "index": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "instance"], "properties": { "kind": { "const": "promotedOverride" }, "instance": { "$ref": "#/$defs/nodeKey" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "node"], "properties": { "kind": { "const": "primitiveWidget" }, "node": { "$ref": "#/$defs/nodeKey" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["namedApi", "definitionDefault", "sourceDefault", "link", "bridgeSerialized"] } } }
      ]
    },
    "inputProvenance": {
      "type": "object", "additionalProperties": false, "required": ["execId", "inputName", "origin"],
      "properties": { "execId": { "type": "string", "minLength": 1 }, "inputName": { "type": "string", "minLength": 1 }, "origin": { "$ref": "#/$defs/valueOrigin" } }
    },
    "sourceMap": {
      "type": "object", "additionalProperties": false, "required": ["execToSource"],
      "properties": { "execToSource": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nodeLocator" } } }
    },
    "artifactDigests": {
      "type": "object", "additionalProperties": false, "required": ["graph", "definition", "serializer", "rules"],
      "properties": { "graph": { "type": "string" }, "definition": { "type": "string" }, "serializer": { "type": "string" }, "rules": { "type": "string" } }
    },
    "compiledArtifact": {
      "type": "object", "additionalProperties": false, "required": ["apiPrompt", "sourceMap", "inputs", "retained", "pruned", "diagnostics", "digests"],
      "properties": {
        "apiPrompt": { "type": "object" },
        "sourceMap": { "$ref": "#/$defs/sourceMap" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/inputProvenance" } },
        "retained": { "type": "array", "items": { "type": "string" } },
        "pruned": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "minItems": 2, "maxItems": 2 } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/compileDiagnostic" } },
        "digests": { "$ref": "#/$defs/artifactDigests" }
      }
    },
    "bridgeEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceDigest", "definitionDigest", "frontendVersion", "pluginDigest", "apiPrompt", "sourceMap", "consumedWidgets", "consumedWidgetOwners"],
      "description": "Reply of POST /compile (client role). consumedWidgets items are canvas::widgets::WidgetConsumption (tag=kind). consumedWidgetOwners[i] is the exec id owning consumedWidgets[i] (same length; L02 field growth accepted by C).",
      "properties": {
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "definitionDigest": { "$ref": "#/$defs/digest" },
        "frontendVersion": { "type": "string", "minLength": 1 },
        "pluginDigest": { "$ref": "#/$defs/digest" },
        "apiPrompt": { "type": "object" },
        "sourceMap": { "$ref": "#/$defs/sourceMap" },
        "consumedWidgets": { "type": "array", "items": { "type": "object", "required": ["kind", "index"], "properties": { "kind": { "enum": ["namedInput", "uiOnly", "linked", "blocked"] }, "index": { "type": "integer", "minimum": 0 } } } },
        "consumedWidgetOwners": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "bridgeFailureCode": { "type": "string", "enum": ["sideEffectBlocked", "userGraphMutated", "graphLoadFailed", "graphToPromptFailed", "versionMismatch", "cancelled", "untrustedPackage", "bridgeNotPinned", "missingBridgeHeader", "crossOrigin", "invalidRequest", "bodyTooLarge", "bodyNotJson", "tokenInvalid", "tokenExpired", "scopeMismatch", "sourceDigestMismatch", "noFrontendSession", "queueFull", "timeout"] },
    "bridgeWire": {
      "description": "CW14 compile-only wire under the ComfyUI instance: POST /bgx/import-bridge/v1/session, POST /bgx/import-bridge/v1/compile, POST /bgx/import-bridge/v1/cancel, GET /bgx/import-bridge/v1/status. No /prompt, save, download or script eval. Every request carries header `X-BGX-Import-Bridge: 1` and the ComfyUI user header (comfy-user); same-origin is enforced (marker header + Origin==Host + Sec-Fetch-Site). HTTP 404 on /status means NotInstalled. Errors: non-2xx with errorBody.",
      "type": "object", "additionalProperties": false, "properties": {}
    },
    "bridgeStatusReply": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["protocol", "kind"], "properties": { "protocol": { "const": "1" }, "kind": { "const": "needsFrontendSession" } } },
        { "type": "object", "additionalProperties": false, "required": ["protocol", "kind", "expected", "actual"], "properties": { "protocol": { "const": "1" }, "kind": { "const": "versionMismatch" }, "expected": { "type": "string" }, "actual": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["protocol", "kind", "sessionId"], "properties": { "protocol": { "const": "1" }, "kind": { "const": "ready" }, "sessionId": { "type": "string", "minLength": 1 } } }
      ]
    },
    "bridgeClientSessionRequest": {
      "type": "object", "additionalProperties": false, "required": ["role", "instanceId", "userScope", "nonce", "ttlSeconds"],
      "properties": {
        "role": { "const": "client" },
        "instanceId": { "type": "string", "minLength": 1 },
        "userScope": { "type": "string", "minLength": 1 },
        "nonce": { "type": "string", "minLength": 16 },
        "ttlSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "bridgeClientSessionReply": {
      "type": "object", "additionalProperties": false, "required": ["protocol", "token", "sessionId", "instanceId", "userScope", "nonce", "ttlSeconds", "expiresAtMs"],
      "description": "One-time compile token. instanceId/userScope/nonce MUST echo the request; the host refuses a foreign or expired reply.",
      "properties": {
        "protocol": { "const": "1" },
        "token": { "type": "string", "minLength": 16 },
        "sessionId": { "type": "string", "minLength": 1 },
        "instanceId": { "type": "string", "minLength": 1 },
        "userScope": { "type": "string", "minLength": 1 },
        "nonce": { "type": "string", "minLength": 16 },
        "ttlSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "expiresAtMs": { "type": "integer", "minimum": 0 }
      }
    },
    "bridgeFrontendSessionRequest": {
      "type": "object", "additionalProperties": false, "required": ["role", "clientId", "frontendVersion"],
      "properties": { "role": { "const": "frontend" }, "clientId": { "type": "string", "minLength": 1 }, "frontendVersion": { "type": "string", "minLength": 1 } }
    },
    "bridgeFrontendSessionReply": {
      "type": "object", "additionalProperties": false, "required": ["protocol", "frontendSessionId", "frontendSecret"],
      "properties": { "protocol": { "const": "1" }, "frontendSessionId": { "type": "string", "minLength": 1 }, "frontendSecret": { "type": "string", "minLength": 16 } }
    },
    "bridgeCompileRequest": {
      "type": "object", "additionalProperties": false, "required": ["token", "sourceDigest", "workflow"],
      "properties": {
        "token": { "type": "string", "minLength": 16 },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "workflow": { "type": "string", "minLength": 1, "description": "Raw workflow text, byte-exact (UTF-8); sourceDigest = sha256 over these bytes." }
      }
    },
    "bridgeFrontendResult": {
      "type": "object", "additionalProperties": false, "required": ["role", "frontendSessionId", "frontendSecret", "jobId", "outcome"],
      "properties": {
        "role": { "const": "frontendResult" },
        "frontendSessionId": { "type": "string", "minLength": 1 },
        "frontendSecret": { "type": "string", "minLength": 16 },
        "jobId": { "type": "string", "minLength": 1 },
        "outcome": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind", "evidence"], "properties": { "kind": { "const": "evidence" }, "evidence": { "$ref": "#/$defs/bridgeEvidence" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "code", "detail"], "properties": { "kind": { "const": "failed" }, "code": { "$ref": "#/$defs/bridgeFailureCode" }, "detail": {} } }
          ]
        }
      }
    },
    "bridgeCancelRequest": {
      "type": "object", "additionalProperties": false, "required": ["token"],
      "properties": { "token": { "type": "string", "minLength": 16 } }
    },
    "bridgeErrorBody": {
      "type": "object", "additionalProperties": false, "required": ["error", "detail"],
      "properties": { "error": { "$ref": "#/$defs/bridgeFailureCode" }, "detail": {} }
    }
  },
  "examples": [
    {
      "importSessionId": "imp-20261014-0001",
      "items": [
        {
          "source": { "endpoint": null, "sourceKind": "localFile", "path": "D:/workflows/video_ltx2_5_i2v.json" },
          "entryId": "entry-ltx25-i2v",
          "sourceRevision": 3,
          "sourceDigest": "sha256:1111",
          "status": "ready",
          "readiness": { "sourceSaved": true, "conversionVerified": true, "mappingReady": true, "runtimeReady": { "kind": "ready" } },
          "documentation": { "kind": "complete" },
          "diagnostics": [],
          "nextAction": null
        },
        {
          "source": { "endpoint": { "instanceId": "lan-4090", "userScope": "default" }, "sourceKind": "remoteUserdata", "path": "workflows/video_fasth3_i2v.json" },
          "entryId": "entry-fasth3",
          "sourceRevision": 1,
          "sourceDigest": "sha256:3333",
          "status": "needsDefinitions",
          "readiness": { "sourceSaved": true, "conversionVerified": false, "mappingReady": false, "runtimeReady": { "kind": "unknown" } },
