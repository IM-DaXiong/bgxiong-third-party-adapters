{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgxiong.local/wan22-s2v/input.schema.json",
  "title": "VideoSpeechV1Input",
  "description": "One portrait and an actual prepared driving-audio segment; no voice cloning or soundtrack substitution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "portrait",
    "drivingAudio",
    "audio",
    "instruction",
    "parameters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "portrait": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/mediaRef"
      }
    },
    "drivingAudio": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/mediaRef"
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationMs",
        "sampleRateHz",
        "channels",
        "sha256"
      ],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255875
        },
        "sampleRateHz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "instruction": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution",
        "fps",
        "seed"
      ],
      "properties": {
        "resolution": {
          "type": "string",
          "enum": ["832x480", "480x832", "1280x720", "720x1280"],
          "oneOf": [
            {"const": "832x480", "title": "480p · 832 × 480"},
            {"const": "480x832", "title": "480p · 480 × 832"},
            {"const": "1280x720", "title": "720p · 1280 × 720"},
            {"const": "720x1280", "title": "720p · 720 × 1280"}
          ],
          "default": "832x480"
        },
        "fps": {
          "type": "integer",
          "enum": [16],
          "default": 16
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967045,
          "default": 20
        }
      }
    }
  },
  "$defs": {
    "mediaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaId"
      ],
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        }
      }
    }
  }
}
