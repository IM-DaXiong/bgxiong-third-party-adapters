{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt",
    "inputMode",
    "durationSeconds",
    "fps",
    "width",
    "height",
    "seed",
    "audio",
    "audioStartSeconds"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "default": "The person shown in the first frame remains the same person and talks while looking toward the camera. Mouth movement, blinking, and small natural shifts in expression and head position follow the timing of the supplied speech. Face, hair, clothing, and background stay consistent with the first frame. This is a single continuous take with a static camera, holding a medium close-up of the head and shoulders, with no pan, zoom, or cut. Lighting stays unchanged from the opening shot."
    },
    "negativePrompt": {
      "type": "string"
    },
    "inputMode": {
      "type": "string",
      "const": "image_to_video"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "default": 5
    },
    "fps": {
      "type": "integer",
      "minimum": 6,
      "maximum": 120,
      "default": 24
    },
    "width": {
      "type": "integer",
      "minimum": 256,
      "maximum": 2048,
      "multipleOf": 64,
      "default": 1280
    },
    "height": {
      "type": "integer",
      "minimum": 256,
      "maximum": 2048,
      "multipleOf": 64,
      "default": 704
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "default": 0
    },
    "audioStartSeconds": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "audio": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaId"
        ],
        "properties": {
          "mediaId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "image": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaId"
        ],
        "properties": {
          "mediaId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
