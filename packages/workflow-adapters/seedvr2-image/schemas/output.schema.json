{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["promptId", "sourceWidth", "sourceHeight", "width", "height", "scaleX", "scaleY"],
  "properties": {
    "promptId": {"type": "string", "minLength": 1},
    "sourceWidth": {"type": "integer", "minimum": 1},
    "sourceHeight": {"type": "integer", "minimum": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "scaleX": {"type": "number", "exclusiveMinimum": 0},
    "scaleY": {"type": "number", "exclusiveMinimum": 0}
  }
}
