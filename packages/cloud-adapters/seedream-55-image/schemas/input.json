{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "string",
      "pattern": "^(1K|1\\.5K|2K|[1-9][0-9]{0,7}x[1-9][0-9]{0,7})$",
      "default": "2K"
    },
    "responseFormat": {
      "type": "string",
      "enum": [
        "url",
        "b64_json"
      ],
      "default": "url"
    },
    "outputFormat": {
      "type": "string",
      "enum": [
        "png",
        "jpeg"
      ],
      "default": "png"
    },
    "background": {
      "type": "string",
      "enum": [
        "auto",
        "transparent",
        "opaque"
      ],
      "default": "auto"
    },
    "watermark": {
      "type": "boolean",
      "default": true
    },
    "aspectRatio": {
      "type": "string",
      "enum": [
        "auto",
        "1:1",
        "4:3",
        "3:4",
        "16:9",
        "9:16",
        "3:2",
        "2:3",
        "21:9",
        "5:4",
        "4:5"
      ],
      "default": "auto"
    },
    "resolution": {
      "type": "string",
      "enum": [
        "1K",
        "1.5K",
        "2K",
        "custom"
      ],
      "default": "2K"
    }
  },
  "required": [
    "prompt"
  ],
  "additionalProperties": false
}
