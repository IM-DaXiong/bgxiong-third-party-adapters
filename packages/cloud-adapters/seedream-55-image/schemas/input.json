{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "string",
      "pattern": "^(1K|1\\.5K|2K|[1-9][0-9]{0,7}x[1-9][0-9]{0,7})$",
      "default": "2K"
    },
    "responseFormat": {
      "type": "string",
      "enum": [
        "url",
        "b64_json"
      ],
      "default": "url"
    },
    "outputFormat": {
      "type": "string",
      "enum": [
        "png",
        "jpeg"
      ],
      "default": "png"
    },
    "background": {
      "type": "string",
      "enum": [
        "auto",
        "transparent",
        "opaque"
      ],
      "default": "auto"
    },
    "watermark": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "prompt"
  ],
  "additionalProperties": false
}
