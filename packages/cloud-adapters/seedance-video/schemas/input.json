{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "inputMode": { "type": "string" },
    "prompt": { "type": "string", "maxLength": 5000 },
    "durationSeconds": {
      "type": "integer",
      "minimum": -1,
      "maximum": 30,
      "anyOf": [{ "const": -1 }, { "minimum": 4 }],
      "default": -1
    },
    "resolution": { "type": "string", "enum": ["480p", "720p"] },
    "aspectRatio": { "type": "string", "enum": ["adaptive", "16:9", "4:3", "1:1", "3:4", "9:16", "21:9"] },
    "generateAudio": { "type": "boolean" },
    "returnLastFrame": { "type": "boolean" },
    "outputFormat": { "type": "string", "enum": ["mp4", "mov"] },
    "priority": { "type": "integer", "minimum": 0, "maximum": 9 },
    "watermark": { "type": "boolean" },
    "safetyIdentifier": { "type": "string", "minLength": 1, "maxLength": 64 },
    "webSearch": { "type": "boolean" }
  },
  "required": ["inputMode"],
  "additionalProperties": false
}
