{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt",
    "inputMode",
    "durationSeconds",
    "fps",
    "resolution",
    "aspectRatio",
    "referenceImages"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "inputMode": {
      "type": "string",
      "const": "multi_image_to_video",
      "default": "multi_image_to_video"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 3,
      "maximum": 30,
      "default": 5
    },
    "fps": {
      "type": "integer",
      "const": 24,
      "default": 24
    },
    "resolution": {
      "type": "string",
      "enum": [
        "720p",
        "1080p"
      ],
      "default": "1080p"
    },
    "aspectRatio": {
      "type": "string",
      "enum": [
        "21:9",
        "16:9",
        "9:16",
        "1:1",
        "adaptive"
      ],
      "default": "adaptive"
    },
    "referenceImages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaId"
        ],
        "properties": {
          "mediaId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
